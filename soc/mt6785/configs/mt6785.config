# HakiOS MT6785 SoC fragment: the facts and the drivers of the SoC family.
# M1 (mtkchain) does not build XNU; M2 fills these in as the MT6768-common
# drivers are adapted and tested on begonia.
CONFIG_SOC=mt6785

# The common `mtk` branch's MT6768 drivers are the starting point:
#   HAKIOS_CPUFREQ, HAKIOS_THERMAL, HAKIOS_SOCINFO, HAKIOS_MALI,
#   HAKIOS_MTK_EMMC/MTK_UFS, HAKIOS_CONNSYS, ...
# They are enabled here only after their MT6785 registers are verified.
