# HakiOS fragment: the Xiaomi Redmi Note 8 Pro (begonia) -- what is true of
# this phone and of no other with an MT6785.
#
# M1 is the mtkchain chainloader and does not enable XNU drivers. M2 adds the
# phone's drivers here, one at a time, as they are seen to work on hardware.
CONFIG_DEVICE="begonia"

# TBD with the MT6785 port:
#CONFIG_HAKIOS_TCM=y
#CONFIG_BUTTONS=2
#CONFIG_MTK_CPUFREQ=3
#CONFIG_MALI=y
#CONFIG_FBSCALE=2
#CONFIG_BOOTARGS="touchscreen=2"
